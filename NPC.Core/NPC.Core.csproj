<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <GameManagedDir Condition="'$(GameManagedDir)' == ''">$(MSBuildThisFileDirectory)lib</GameManagedDir>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>NPC.Core</AssemblyName>
    <RootNamespace>NPC.Core</RootNamespace>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <Version>1.0.2</Version>
    <!-- Mods bind to major.minor.0.0 whatever the patch level: BepInDependency checks the real version. -->
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <Deterministic>true</Deterministic>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- Shipped next to the DLL, so a mod built against it gets the API docs in its IDE. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- The ready-made nav graph. NavGraph extracts it to BepInEx/config/NPC.Core/nodegraph.bundled.json
         whenever its BundleVersion changes; regenerate it with tools/bundle_nodegraph.py. -->
    <EmbeddedResource Include="Resources/nodegraph.bundled.json" LogicalName="NPC.Core.Resources.nodegraph.bundled.json" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="0Harmony">
      <HintPath>lib\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="$(GameManagedDir)\Assembly-CSharp.dll">
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx">
      <HintPath>lib\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="$(GameManagedDir)\Newtonsoft.Json.dll">
      <Private>false</Private>
    </Reference>
    <Reference Include="$(GameManagedDir)\FMODUnity.dll">
      <Private>false</Private>
    </Reference>
    <Reference Include="$(GameManagedDir)\UnityEngine.dll">
      <Private>false</Private>
    </Reference>
    <Reference Include="$(GameManagedDir)\UnityEngine.AnimationModule.dll">
      <Private>false</Private>
    </Reference>
    <Reference Include="$(GameManagedDir)\UnityEngine.CoreModule.dll">
      <Private>false</Private>
    </Reference>
    <Reference Include="$(GameManagedDir)\UnityEngine.PhysicsModule.dll">
      <Private>false</Private>
    </Reference>
    <Reference Include="$(GameManagedDir)\UnityEngine.IMGUIModule.dll">
      <Private>false</Private>
    </Reference>
    <Reference Include="$(GameManagedDir)\UnityEngine.TextRenderingModule.dll">
      <Private>false</Private>
    </Reference>
    <Reference Include="$(GameManagedDir)\UnityEngine.InputLegacyModule.dll">
      <Private>false</Private>
    </Reference>
    <Reference Include="$(GameManagedDir)\Unity.InputSystem.dll">
      <Private>false</Private>
    </Reference>
    <Reference Include="$(GameManagedDir)\UnityEngine.UI.dll">
      <Private>false</Private>
    </Reference>
    <Reference Include="$(GameManagedDir)\Unity.TextMeshPro.dll">
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Unity.Analyzers" Version="1.27.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- Every public member is listed in PublicAPI.*.txt, so a change to what mods build against is a
         visible diff: docs/api.md#9-changing-the-api -->
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="4.14.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>

</Project>
